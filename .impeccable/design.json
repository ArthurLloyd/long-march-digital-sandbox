      "html": "<nav class=\"ds-nav\" aria-label=\"顶部导航\"><button>关于展馆</button><button>史料原则</button></nav>",
      "css": ".ds-nav{display:flex;gap:36px;background:linear-gradient(180deg,#080c11eb,#080c1180 65%,transparent)}.ds-nav button{font-family:var(--font-body);font-size:16px;line-height:1.8;cursor:pointer;transition:color .2s,background-color .2s,border-color .2s,transform .3s var(--ease-out);position:relative;display:flex;align-items:center;gap:8px;padding:8px 0;font-size:15px;color:var(--muted);border:0;background:none}.ds-nav button::after{content:'';position:absolute;left:0;right:0;bottom:3px;height:1px;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .3s var(--ease-out)}.ds-nav button:hover{color:var(--gold-bright)}.ds-nav button:hover::after,.ds-nav button:focus-visible::after{transform:scaleX(1)}.ds-nav button:focus-visible{outline:2px solid var(--gold-bright);outline-offset:5px}.ds-nav button:disabled{opacity:.4;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-nav button,.ds-nav button::before,.ds-nav button::after{animation:none!important;transition:none!important}}"

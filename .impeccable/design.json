      "css": ".ds-quiet{font-family:var(--font-body);font-size:16px;line-height:1.8;cursor:pointer;transition:color .2s,background-color .2s,border-color .2s,transform .3s var(--ease-out);position:relative;display:inline-flex;align-items:center;gap:8px;padding:10px 0;border:0;background:none;color:var(--muted);font-size:15px}.ds-quiet::after{content:'';position:absolute;left:0;right:0;bottom:3px;height:1px;background:var(--gold);transform:scaleX(.2);transform-origin:left;opacity:.35;transition:transform .35s var(--ease-out),opacity .35s}.ds-quiet:hover{color:var(--gold-bright)}.ds-quiet:hover::after,.ds-quiet:focus-visible::after{transform:scaleX(1);opacity:1}.ds-quiet:focus-visible{outline:2px solid var(--gold-bright);outline-offset:5px}.ds-quiet:disabled{opacity:.4;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-quiet,.ds-quiet::before,.ds-quiet::after{animation:none!important;transition:none!important}}"
    },

  "components": [
    {
      "name": "开启征程",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "双金线朱红入口，旅程纹样与两行文案，悬停和焦点触发扫光。",
      "html": "<button class=\"ds-enter\" aria-label=\"开启征程\"><span class=\"ds-enter-copy\">开启征程<small>进入三维历史沙盘</small></span><svg xmlns=\"http://www.w3.org/2000/svg\" class=\"ds-enter-arrow\" aria-hidden=\"true\" width=\"69\" height=\"57\" viewBox=\"0 0 88 72\" fill=\"none\"> <defs> <linearGradient id=\"ds-journey-gold\" x1=\"10\" y1=\"9\" x2=\"75\" y2=\"63\" gradientUnits=\"userSpaceOnUse\"> <stop stop-color=\"#f0d8a1\"/> <stop offset=\".5\" stop-color=\"#b08c57\"/> <stop offset=\"1\" stop-color=\"#e5c997\"/> </linearGradient> </defs> <path d=\"m45 5 25 14v34L45 67 20 53V19L45 5Z\" stroke=\"url(#ds-journey-gold)\" stroke-width=\".8\" opacity=\".7\"/> <path d=\"m45 10 21 12v28L45 62 24 50V22L45 10Z\" stroke=\"#e4caa0\" stroke-width=\".6\" opacity=\".25\"/> <path d=\"m29 44 9-8 9 7 9-11 7 8M28 49l12-7 9 7 11-4\" stroke=\"#e4caa0\" stroke-width=\".8\" opacity=\".35\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/> <path d=\"M8 35h55m-8-8 9 8-9 8\" stroke=\"#f0d8ac\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/> <path d=\"M9 30h12M13 40h9m48-5h8M45 1v3m0 64v3\" stroke=\"#d3b27a\" stroke-width=\".7\" opacity=\".7\"/> <path d=\"m45 14 1.8 3-1.8 3-1.8-3 1.8-3Z\" fill=\"#e4caa0\"/> </svg></button>",
      "css": ".ds-enter{font-family:var(--font-body);font-size:16px;line-height:1.8;cursor:pointer;transition:color .2s,background-color .2s,border-color .2s,transform .3s var(--ease-out);position:relative;overflow:hidden;isolation:isolate;display:flex;align-items:center;justify-content:space-between;gap:26px;background:var(--red-muted);color:var(--text);border:1px solid #c5a46d80;padding:15px 18px 15px 25px;min-width:270px;min-height:88px;font-size:18px;letter-spacing:.12em;box-shadow:0 12px 32px #0003}.ds-enter::after{content:'';position:absolute;inset:4px;border:1px solid #c5a46d30;pointer-events:none;transition:border-color .3s}.ds-enter::before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(110deg,transparent 25%,#e4caa01a,transparent 65%);transform:translateX(-110%);transition:transform .65s var(--ease-out)}.ds-enter:hover::before,.ds-enter:focus-visible::before{transform:translateX(110%)}.ds-enter-copy{display:block;text-align:left;font-weight:600}.ds-enter-copy small{display:block;margin-top:3px;color:#e5cdb8;font-size:11px;font-weight:400;letter-spacing:.12em}.ds-enter-arrow{display:block;width:69px;height:57px;flex:0 0 auto;object-fit:contain;transition:transform .35s var(--ease-out)}.ds-enter:hover::after,.ds-enter:focus-visible::after{border-color:#e4caa080}.ds-enter:not(:disabled):hover{background:var(--red);border-color:var(--gold-bright);transform:translateY(-3px);color:var(--text)}.ds-enter:active{transform:translateY(0)}.ds-enter:hover .ds-enter-arrow,.ds-enter:focus-visible .ds-enter-arrow{transform:translateX(4px)}.ds-enter:focus-visible{outline:2px solid var(--gold-bright);outline-offset:5px}.ds-enter:disabled{opacity:.4;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-enter,.ds-enter::before,.ds-enter::after{animation:none!important;transition:none!important}}@media(prefers-reduced-motion:reduce){.ds-enter-arrow{transition:none!important}}@media(min-width:768px) and (max-height:820px){.ds-enter{min-height:72px;padding-block:12px}}@media(max-width:767px){.ds-enter{padding:14px 20px;min-width:182px;font-size:16px;gap:18px}.ds-enter-arrow{width:48px;height:44px}}"
    },
    {
      "name": "文字操作",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "首页底部右侧的了解作品入口，以短金线响应悬停和焦点。",
